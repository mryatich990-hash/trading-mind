# ============================================================
# AI Forex Trading System - environment template (master prompt)
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- deployment ----
ENVIRONMENT=production
PORT=5000
# Local default: SQLite. On Render point this at Supabase's POOLED connection
# (Dashboard -> Project Settings -> Database -> Connection pooling, port 6543):
#   postgresql+psycopg2://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL=sqlite:///trading_system.db
SECRET_KEY=generate_a_long_random_string
TZ_DISPLAY_OFFSET_HOURS=3

# ---- Supabase (cloud Postgres + realtime) ----
# Dashboard -> Settings -> API. SERVICE key is SECRET (engine only, on Render).
# ANON key is public-safe (Vercel dashboard, reads via RLS policies).
# SUPABASE_DB_URL holds the same pooled URL as DATABASE_URL above (kept as a
# separate name for tooling that expects it).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# ---- broker: MetaTrader 5 ----
# MT5 is the PRIMARY data feed (free, unlimited, broker-direct). It requires
# the MetaTrader5 package (Windows/macOS). On hosts without it (Linux/Render)
# yfinance becomes the effective primary automatically - no config change.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- broker: OANDA (fallback) ----
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ---- AI: Groq (decision brain + verifier) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VERIFY_THRESHOLD=82
GROQ_MIN_CONVICTION=74
GROQ_MAX_REJECTIONS=5

# ---- news / data feeds ----
# DATA FEED CHAIN: MT5 (primary, free/unlimited) -> yfinance (secondary,
# keyless) -> Twelve Data (tertiary, 800/day free). Alpha Vantage was
# REMOVED (25 req/day free tier killed the feed for 54+ hours).
NEWS_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=
MYFXBOOK_API_KEY=
FOREXFACTORY_RSS=https://nfs.faireconomy.media/ff_calendar_thisweek.xml

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- trading gates ----
DEMO_MODE=true
MIN_CONFLUENCE=8
MAX_CONFLUENCE=10
MAX_DAILY_LOSS_PCT=3
RISK_PER_TRADE_PCT=1
MAX_RISK_PER_TRADE_PCT=1.5
MIN_RISK_PER_TRADE_PCT=0.25
MAX_OPEN_TRADES=2
MAX_TOTAL_OPEN_RISK_PCT=3
MAX_TRADES_PER_DAY=8
MIN_ACCOUNT_BALANCE=50

# ---- selector ----
SELECTOR_MIN_SCORE=70

# ---- circuit breakers ----
STALENESS_LIMIT_SEC=600
# Full halt only after the feed is dead this long (before that: observation mode)
FEED_DEAD_LIMIT_SEC=1800
VIX_HALT=40
VIX_REDUCE_60=30
VIX_REDUCE_30=20
ATR_EXPLOSION_MULT=2.5
MARGIN_ALERT_PCT=500
MARGIN_REDUCE_PCT=300
MARGIN_HALT_PCT=200
DRAWDOWN_HALT_PCT=10

# ---- pairs (priority order) ----
TRADING_PAIRS=EURUSD,GBPUSD,XAUUSD,USDJPY,GBPJPY,EURJPY,NAS100,US30,USDCHF,AUDUSD

# ---- engine cadence (seconds) ----
CYCLE_INTERVAL_SEC=60
MANAGE_INTERVAL_SEC=60
HEALTH_INTERVAL_SEC=180

# ---- ML ----
ML_MODEL_DIR=/data/models
ML_RETRAIN_EVERY=25
ML_LOSS_SKIP_THRESHOLD=0.60
ML_MIN_TRAIN=30

# ---- backtest / demo gates ----
BACKTEST_GATE_MIN_STRATEGIES=5
BACKTEST_GATE_WIN_RATE=45
BACKTEST_GATE_PROFIT_FACTOR=1.2
DEMO_GATE_TRADES=60
DEMO_GATE_WIN_RATE=52
DEMO_GATE_PROFIT_FACTOR=1.3

# ---- TradingView webhook ----
# Secret string included in every TradingView alert JSON as "secret": ...
TV_WEBHOOK_SECRET=
TV_WEBHOOK_PORT=5555

# ---- TradingView email bridge (free-plan alternative to webhooks) ----
# Gmail: enable 2FA, create an app password, use it as BRIDGE_EMAIL_PASSWORD
BRIDGE_IMAP_HOST=imap.gmail.com
BRIDGE_EMAIL_USER=
BRIDGE_EMAIL_PASSWORD=
BRIDGE_IMAP_FOLDER=INBOX
BRIDGE_POLL_SEC=20

# ---- dashboard ----
DASHBOARD_REFRESH_SEC=30
DASHBOARD_ENABLED=1

# ---- upgrade toggles (defaults on; heavy deps guarded with fallbacks) ----
DEEP_LEARNING_ENABLED=true
NLP_ENABLED=true
TICK_DATA_ENABLED=true
SCALPING_ENABLED=true
STAT_ARB_ENABLED=true
GOOGLE_TRENDS_ENABLED=true
DL_MODELS_DIR=/data/models
DL_RETRAIN_CANDLES=200
DL_RETRAIN_TRADES=30
DL_MIN_ACCURACY=52
SCALP_RISK_PCT=0.5
SCALP_MAX_PER_SESSION=5
STATARB_MAX_POSITIONS=1
STATARB_RISK_PCT=0.5
REDIS_URL=
TWITTER_BEARER_TOKEN=
HUGGINGFACE_TOKEN=

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://openapi.ctrader.com/apps
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo

# ---- Vercel dashboard (dashboard-nextjs/) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RENDER_HEALTH_URL=
